# ============================================================
# NVRSMS Platform — Environment Variables
# Copy to .env and fill in all values marked <CHANGE_ME>
# NEVER commit .env to version control
# ============================================================

# ----- Hub Backend -----
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=<CHANGE_ME_min_32_chars_random>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- Database -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nvrsms
POSTGRES_USER=nvrsms
POSTGRES_PASSWORD=<CHANGE_ME>
DATABASE_URL=postgresql+asyncpg://nvrsms:<CHANGE_ME>@postgres:5432/nvrsms

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ----- CORS -----
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ----- MediaMTX -----
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_PUBLISH_URL=rtsp://mediamtx:8554
MEDIAMTX_WHIP_URL=http://mediamtx:8889

# ----- Agent Control Channel -----
AGENT_WS_PATH=/ws/agent
AGENT_HEARTBEAT_INTERVAL=30
AGENT_HEARTBEAT_TIMEOUT=90

# ----- Security -----
RATE_LIMIT_LOGIN=5/minute
BCRYPT_ROUNDS=12
TOTP_ISSUER=NVRSMS

# ----- Backup -----
BACKUP_ENCRYPTION_KEY=<CHANGE_ME_32_bytes_base64>
BACKUP_STORAGE_PATH=/backups
BACKUP_RETENTION_DAYS=30

# ----- Super Admin (seed) -----
SUPER_ADMIN_EMAIL=admin@nvrsms.local
SUPER_ADMIN_PASSWORD=<CHANGE_ME>

# ----- Caddy / TLS -----
CADDY_EMAIL=admin@yourdomain.com
DOMAIN=yourdomain.com
