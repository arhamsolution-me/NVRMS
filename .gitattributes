# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit shell and automation files
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Jenkinsfile text eol=lf
Jenkinsfile.* text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf

# Binary files
*.tar.gz binary
*.zip binary
*.db binary
*.png binary
*.jpg binary
*.mp4 binary
