# Caddyfile — Hardened Reverse Proxy with TLS 1.3 / 1.2-AEAD & mTLS
# Reference: Mozilla Modern TLS Guideline & Section 2 Transport Security

{
    # Global TLS parameters: Enforce TLS 1.2 minimum with AEAD-only ciphers
    servers :443 {
        protocols tls1.2 tls1.3
        ciphers TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
    }
}

# ── 1. HTTP to HTTPS Ingress Redirect ─────────────────────────
:80 {
    # Strictly reject unencrypted control / media traffic and redirect to HTTPS
    @insecure {
        not path /health
    }
    redir @insecure https://{host}{uri} permanent

    # Local container healthcheck allowed over loopback only
    handle /health {
        reverse_proxy hub-backend:8000
    }
}

# ── 2. Primary Hardened HTTPS / WSS Ingress ───────────────────
:443 {
    tls internal {
        protocols tls1.2 tls1.3
        ciphers TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
    }

    # Strict Security Headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Health Checks
    handle /health {
        reverse_proxy hub-backend:8000
    }

    # Central REST API
    handle /api/* {
        reverse_proxy hub-backend:8000
    }

    # Agent Outbound WSS Control Channel
    handle /ws/* {
        reverse_proxy hub-backend:8000
    }

    # MediaMTX WebRTC / WHIP / WHEP Ingress
    handle /whip/* {
        reverse_proxy mediamtx:8889
    }

    handle /whep/* {
        reverse_proxy mediamtx:8889
    }

    # Token-Protected HLS Video Segments
    handle /hls/* {
        reverse_proxy mediamtx:8888
    }

    # Frontend Single Page App
    handle {
        reverse_proxy hub-backend:8000
    }

    log {
        output stdout
        format json
    }
}
